<?xml version="1.0" encoding="utf-8"?>
<!-- Pre-Android-12 counterpart of data_extraction_rules.xml: excludes every
     backup domain so nothing leaves the device, matching allowBackup="false". -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
